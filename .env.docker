# Application
APP_NAME=小灶AI家庭管家
APP_VERSION=0.1.0
DEBUG=false

# Database (PostgreSQL async) - uses 'postgres' as Docker service hostname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_family_butler

# Redis - uses 'redis' as Docker service hostname
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Aliyun OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_BASE_URL=

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# SMS
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# AI Services - DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# AI Services - DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# AI Services - OpenAI Compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# AI Services - Stable Diffusion
SD_API_KEY=
SD_BASE_URL=

# Celery - uses 'redis' as Docker service hostname
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Encryption (32 bytes for AES-256)
ENCRYPTION_KEY=change-me-32-byte-key-for-aes256

# CORS
CORS_ORIGINS=["*"]

# PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_family_butler
